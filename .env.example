# Timezone
TZ=Asia/Taipei

# MariaDB Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=twstk_db
MYSQL_USER=twstk_user
MYSQL_PASSWORD=your_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# API Sources
# TWSE Open API (no token needed usually)
TWSE_STOCK_DAY_ALL_URL=https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL

# FinMind API
FINMIND_API_URL=https://api.finmindtrade.com/api/v4/data
FINMIND_API_TOKEN=your_finmind_token_here
FINMIND_MAX_REQUESTS_PER_HOUR=550
FINMIND_SLEEP_SECONDS=7

# Fallback
YFINANCE_SUFFIX=.TW

# Project Paths
PROJECT_DIR=.
LOG_FILE=logs/app.log
OUTPUT_DIR=output
MODEL_DIR=models

# Analysis Settings
DATA_COLLECTION_DAYS=14
MIN_HISTORY_DAYS=14
TRAIN_LOOKBACK_DAYS=365
PREDICTION_TOP_N=20
MODEL_VERSION=v1_baseline
MODEL_RETRAIN_DAYS=7

# Flask
FLASK_SECRET_KEY=your_flask_secret_key_here
